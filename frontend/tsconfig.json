{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "exclude": [
    "src/components/AuthModal.tsx",
    "src/components/ChatAssistant.tsx",
    "src/components/DocumentChecklist.tsx",
    "src/components/EligibilityWizard.tsx",
    "src/components/Footer.tsx",
    "src/components/HeroSection.tsx",
    "src/components/Navbar.tsx",
    "src/components/SchemeCatalog.tsx",
    "src/components/SchemeComparison.tsx",
    "src/components/SchemeDetailModal.tsx",
    "src/components/TopBar.tsx",
    "src/components/AdminConsole.tsx",
    "src/components/AnalyticsDashboard.tsx",
    "src/components/AuthGate.tsx",
    "src/api.ts"
  ]
}
