# =====================================================================
# eGovSeva - AI Public Service Assistant Configuration Template
# Copy this file to '.env' and populate with your environment settings.
# DO NOT commit real secrets or credentials to source control.
# =====================================================================

# ---------------------------------------------------------------------
# Database Configuration
# ---------------------------------------------------------------------
# Primary MongoDB Atlas connection URI (Optional for offline mock/SQLite mode)
# Example Atlas URI: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=egovseva_db

# SQLite / Relational Database URL (Default falls back to local SQLite DB)
# DATABASE_URL=sqlite:///backend/schemes_assistant.db

# ---------------------------------------------------------------------
# JWT Authentication & BCrypt Security
# ---------------------------------------------------------------------
# Secret key used for signing HS256 JWT access tokens (use a strong 256-bit random string in production)
JWT_SECRET_KEY=change_this_to_a_secure_random_256_bit_secret_key_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---------------------------------------------------------------------
# SMTP Email Service Gateway (Optional / Simulated if unconfigured)
# ---------------------------------------------------------------------
# SMTP credentials for OTP delivery and citizen notifications (e.g., Brevo, SendGrid, Amazon SES)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@egovseva.gov.in
SMTP_FROM_NAME="eGovSeva National Portal"
SMTP_TIMEOUT=5

# ---------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# ---------------------------------------------------------------------
# Optional: In development, Vite dev server proxies '/api' to 'http://127.0.0.1:8000'
# In production or standalone deployments, configure the backend API base URL:
# VITE_API_BASE_URL=http://127.0.0.1:8000/api
